{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://artisticview-api.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://artisticview-api.onrender.com/auth/:path*" },
    { "source": "/media/:path*", "destination": "https://artisticview-api.onrender.com/media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
